{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent_Contract_Specification",
  "description": "Formal contract schema for specialized ADAS/AD engineering agents.",
  "type": "object",
  "required": [
    "agent_id",
    "name",
    "phase",
    "role",
    "pinned_knowledge_graphs",
    "skills",
    "inputs",
    "outputs",
    "guardrails",
    "system_instructions"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^AGENT_[0-9]{2}_[A-Z0-9_]+$"
    },
    "name": { "type": "string" },
    "phase": { "type": "string" },
    "role": { "type": "string" },
    "pinned_knowledge_graphs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "script"],
        "properties": {
          "name": { "type": "string" },
          "script": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "format"],
        "properties": {
          "artifact": { "type": "string" },
          "format": { "type": "string" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "format"],
        "properties": {
          "artifact": { "type": "string" },
          "format": { "type": "string" },
          "schema_ref": { "type": "string" }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "system_instructions": {
      "type": "string",
      "minLength": 50
    }
  }
}
