# ============================================================
# ADAS/AD Agentic Framework — LLM Provider Configuration
# ============================================================
# Copy this file to .env in the project root and fill in your provider.
# The framework reads these in priority order: LLM_API_KEY > OPENAI_API_KEY > GEMINI_API_KEY
#
# NEVER commit .env to Git — it is in .gitignore

# ------ OPTION A: OpenAI (GPT-4o, GPT-4-turbo) ------
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ------ OPTION B: Google Gemini (via OpenAI-compatible endpoint) ------
# LLM_API_KEY=AIzaSy...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-pro

# ------ OPTION C: Local Ollama (zero cloud cost, no API key needed) ------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama  # Ollama requires a non-empty value but ignores it

# ------ OPTION D: Local vLLM / LM Studio ------
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# LLM_API_KEY=token-abc123

# ------ OPTION E: Groq (hosted Llama/Mixtral — fast inference) ------
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ------ OPTION F: Mistral AI ------
# LLM_API_KEY=...
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-large-latest

# ------ OPTION G: OpenRouter (unified gateway) ------
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# ============================================================
# If NO env vars are set, the framework runs in OFFLINE_SIM mode.
# All agents will execute with deterministic simulation responses —
# useful for running tests in CI/CD without cloud credentials.
# ============================================================
